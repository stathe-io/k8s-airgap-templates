# Everything the lab pins, in one place.

# v1.35, not the newest k3s: Kyverno v1.19 is tested up to Kubernetes v1.35,
# and v1.35 still receives patches. See docs/decisions.md.
K3S_VERSION=v1.35.9+k3s1
K3S_IMAGE=rancher/k3s:v1.35.9-k3s1@sha256:ec9868c6a38d4e8c1869832fb5fd1eb8473c39794a0b44d2b952e7ba911951bc

# The host's architecture decides which airgap bundle the node needs.
case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) echo "unsupported architecture: $(uname -m)" >&2; exit 2 ;;
esac
K3S_AIRGAP=k3s-airgap-images-$ARCH.tar.zst

CLUSTER=secure-lab
NETWORK=secure-lab

# Part of the k3s airgap bundle, so it runs inside the enclave. Its tag moves
# with the k3s version: check the bundle when K3S_VERSION changes.
BUSYBOX=rancher/mirrored-library-busybox:1.37.0

# Used only to prove that nothing outside the bundle arrives.
UNBUNDLED_IMAGE=nginx:1.27
EGRESS_PROBE=https://1.1.1.1

# The registry inside the enclave plus the tool that loads it from the bundle.
REGISTRY_IMAGE=registry:2.8.3@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
CRANE_IMAGE=gcr.io/go-containerregistry/crane:v0.22.1@sha256:1f968817b95790bed063f71175aa6b8ff879fa17064020415f3e18bb6e6a36e1
REGISTRY=registry:5000
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.1.4@sha256:0f06154836d2de34f887a5c273506d52ca43edaa1d9e53e6510fa78a48f69c2d

# Kyverno publishes no checksum for its install manifest. This is the hash of
# the copy first fetched; the fetch stops if it ever changes.
KYVERNO_VERSION=v1.19.2
KYVERNO_MANIFEST_SHA256=4f785937dc7fe49a0731108b15def1538923c73d9236255bc69d94d498037969

# A copy of a bundled image that the gate did not sign, so the refusal has
# something to refuse.
UNSIGNED_FIXTURE=lab/unsigned
