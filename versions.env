# Everything the lab pins, in one place.

K3S_VERSION=v1.31.4+k3s1
K3S_IMAGE=rancher/k3s:v1.31.4-k3s1

# The host's architecture decides which airgap bundle the node needs.
case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) echo "unsupported architecture: $(uname -m)" >&2; exit 2 ;;
esac
K3S_AIRGAP=k3s-airgap-images-$ARCH.tar.zst

CLUSTER=secure-lab
NETWORK=secure-lab

# Part of the k3s airgap bundle, so it runs inside the enclave.
BUSYBOX=rancher/mirrored-library-busybox:1.36.1

# Used only to prove that nothing outside the bundle arrives.
UNBUNDLED_IMAGE=nginx:1.27
EGRESS_PROBE=https://1.1.1.1

# The registry inside the enclave plus the tool that loads it from the bundle.
REGISTRY_IMAGE=registry:2.8.3@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
CRANE_IMAGE=gcr.io/go-containerregistry/crane:v0.22.1@sha256:1f968817b95790bed063f71175aa6b8ff879fa17064020415f3e18bb6e6a36e1
REGISTRY=registry:5000
